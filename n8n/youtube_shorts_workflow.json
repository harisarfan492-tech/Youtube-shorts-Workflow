      "name": "Execute Command"
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "models/gemini-3-flash-preview"
        },
        "messages": {
          "values": [
            {
              "content": "You write high-retention YouTube Shorts about technology, computing, gaming, and surprising science.\\n\\nWrite ONE original narration for a 20–30 second Short.\\n\\nHOOK:\\n- The first sentence must immediately make someone curious.\\n- Never begin with \\"Did you know?\\"\\n- Lead with the strangest or most surprising part.\\n- Examples of opening styles: \\"A real insect once crashed a computer.\\" or \\"Your phone has more computing power than the computers used for the Moon landing.\\"\\n- Do not copy these examples unless they genuinely fit the topic.\\n\\nSTORY:\\n- Aim for 45–60 words.\\n- Use short, natural spoken sentences.\\n- Explain one specific, accurate fact.\\n- Reveal the interesting detail early, then deliver a satisfying payoff.\\n- Avoid filler, generic introductions, repeated ideas, and fake drama.\\n- End with a memorable line.\\n- Ask the User to Like and Subscribe\\n\\nReturn ONLY the narration as one paragraph. No title, headings, labels, quotation marks, or scene directions. Make the topic different from common overused trivia whenever possible."
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [-256, 0],
      "id": "789b30ed-ab50-4add-a920-0bfc77cb20ac",
      "name": "Message a model"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\\n\\nconst script = item.json.content?.parts?.[0]?.text;\\n\\nif (!script) {\\n  throw new Error(\\"Gemini did not return a script in content.parts[0].text\\");\\n}\\n\\nreturn [\\n  {\\n    json: {\\n      script: script.trim()\\n    }\\n  }\\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [64, 112],
      "id": "0807d614-e860-4703-ab2a-5b1f87a1aa83",
      "name": "Code in JavaScript"
    },
