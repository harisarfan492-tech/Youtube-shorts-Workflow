    {
      "parameters": {
        "jsCode": "\\nconst result = $input.first();\\nconst output = result.json.stdout || \\"\\";\\n\\nconst match = output.match(\\n  /C:\\\\\\\\n8n-content\\\\output\\\\short_[^\\r\\n]+\\\\.mp4/i\\n);\\n\\nif (!match) {\\n  throw new Error(\\"Could not find the generated Short path in Execute Command output.\\");\\n}\\n\\nreturn [\\n  {\\n    json: {\\n      filePath: match[0],\\n      title: \\"Amazing Tech Fact #Shorts\\",\\n      description: \\"A fascinating tech fact! #Shorts #Technology\\",\\n    },\\n  },\\n];\\n"
      },
